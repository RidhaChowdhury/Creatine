{
  "name": "drops-pitwall",
  "main": "index",
  "version": "1.0.0",
  "scripts": {
    "start": "node scripts/start.mjs cloud",
    "dev": "node scripts/start.mjs cloud --web",
    "dev:local": "node scripts/start.mjs local --web",
    "dev:test": "node scripts/start.mjs test --web",
    "android": "node scripts/start.mjs cloud --android",
    "ios": "node scripts/start.mjs cloud --ios",
    "web": "node scripts/start.mjs cloud --web",
    "web:local": "node scripts/start-local.mjs",
    "doctor": "node scripts/doctor.mjs",
    "postinstall": "setup-skia-web && node scripts/patch-expo-worker.mjs",
    "test": "jest --runInBand",
    "test:watch": "jest --watchAll",
    "test:setup": "node --test scripts/__tests__/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "verify:db": "node scripts/verify-tracker-migration.mjs",
    "verify": "npm run typecheck && npm test && npm run test:setup && npm run verify:db && npm run verify:repository",
    "build:web": "node scripts/export-app.mjs web local",
    "build:web:phone": "node scripts/export-app.mjs web phone-preview dist-phone",
    "build:native": "node scripts/export-app.mjs native local",
    "preview": "node scripts/preview.mjs",
    "native:sync": "expo prebuild --no-install",
    "build:web:test": "node scripts/export-app.mjs web test",
    "build:web:preview": "node scripts/export-app.mjs web preview",
    "test:e2e": "playwright test --grep-invert @visual",
    "test:visual": "playwright test --grep @visual",
    "verify:repository": "node scripts/verify-drops-repository.mjs",
    "release:manifest": "node scripts/release-manifest.mjs",
    "deploy:check": "node scripts/verify-deployment.mjs",
    "test:e2e:export": "node scripts/run-browser-tests.mjs",
    "test:cloud": "node scripts/cloud-qa.mjs",
    "test:e2e:cloud": "node scripts/cloud-browser-qa.mjs",
    "test:e2e:cloud:ci": "node scripts/cloud-qa-ci.mjs"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/",
      "/artifacts/",
      "/qa/"
    ]
  },
  "dependencies": {
    "@expo-google-fonts/archivo": "^0.4.2",
    "@expo-google-fonts/barlow-condensed": "^0.4.1",
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@expo/html-elements": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@legendapp/motion": "^2.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/native": "^7.1.6",
    "@reduxjs/toolkit": "^2.8.2",
    "@shopify/react-native-skia": "2.2.12",
    "@supabase/supabase-js": "^2.117.2",
    "@tamagui/animations-react-native": "^2.7.7",
    "@tamagui/config": "2.7.7",
    "@tamagui/font-inter": "2.7.7",
    "babel-plugin-module-resolver": "^5.0.2",
    "d3-shape": "^3.2.0",
    "expo": "~54.0.37",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-blur": "~15.0.8",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-server": "~1.0.7",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.20",
    "expo-web-browser": "~15.0.11",
    "lucide-react-native": "^0.485.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-dotenv": "^3.4.11",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "react-redux": "^9.2.0",
    "tamagui": "2.7.7",
    "victory-native": "^41.20.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@electric-sql/pglite": "^0.5.8",
    "@expo/env": "^2.0.12",
    "@playwright/test": "^1.63.0",
    "@tamagui/metro-plugin": "2.7.7",
    "@types/d3-shape": "^3.1.7",
    "@types/jest": "^29.5.12",
    "@types/pngjs": "^6.0.5",
    "@types/react": "~19.1.10",
    "@types/react-native-dotenv": "^0.2.2",
    "@types/react-test-renderer": "^19.3.0",
    "jest": "^29.2.1",
    "jest-expo": "~54.0.18",
    "jscodeshift": "^0.15.2",
    "pngjs": "^7.0.0",
    "react-test-renderer": "^19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true,
  "engines": {
    "node": "^22.0.0 || ^24.0.0",
    "npm": ">=10 <12"
  },
  "overrides": {
    "postcss": "8.5.28"
  }
}
