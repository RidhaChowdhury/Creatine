# Copy to .env.test.local. Use a separate Supabase project with the migrations applied.
# npm run dev:test rejects the connected production project.
EXPO_PUBLIC_SUPABASE_URL=https://your-test-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Or use EXPO_PUBLIC_SUPABASE_ANON_KEY for a legacy public anon key.
